# Copy to .env and fill in. Never commit the real .env.
#   cp .env.example .env

# Resend API key — https://resend.com/api-keys
# Needs "Sending access". Without this, /api/contact returns 503.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender. The domain MUST be verified in Resend (Domains → Add Domain),
# otherwise Resend rejects every send.
CONTACT_FROM=Nehemiah <noreply@nehemiahapps.com>

# Where submissions land. Comma-separate for multiple recipients.
CONTACT_TO=support@nehemiahapps.com

# Bind address. Keep 127.0.0.1 when nginx sits in front of this.
HOST=127.0.0.1
PORT=4048

# Read the client IP from X-Forwarded-For. Set to 0 only if this process is
# directly exposed to the internet with no proxy.
TRUST_PROXY=1

# Anti-spam: max submissions per IP per window.
RATE_MAX=5
RATE_WINDOW_MS=600000

# ---------------------------------------------------------------
# INBOUND FORWARDING  (optional — only needed if Resend receives
# mail for this domain and you want it in a real inbox)
# ---------------------------------------------------------------

# Signing secret from Resend -> Webhooks -> your endpoint. Starts with whsec_.
# Without it /api/inbound returns 503 and forwards nothing.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# The mailbox you actually read. Comma-separate for several.
FORWARD_TO=your-real-inbox@gmail.com

# Envelope sender for forwarded mail. Must be on a Resend-verified domain —
# you cannot forward "as" the original sender. Reply-To is set to them instead.
FORWARD_FROM=Nehemiah Mail <noreply@nehemiahapps.com>

# Skip attachments past this total size (Resend caps a send at 40 MB).
MAX_ATTACHMENT_BYTES=15728640
